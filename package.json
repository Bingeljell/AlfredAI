{
  "name": "alfredv1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "alfred": "bin/alfred.js"
  },
  "files": [
    "bin/",
    "dist/",
    "webui/",
    "templates/",
    "docs/getting-started.md",
    "docs/architecture/tui.md",
    "docs/operations/alfred-home-migration.md",
    "docs/operations/chatgpt_subscription.md",
    "docs/operations/extensions.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "typecheck": "tsc --noEmit",
    "dev:gateway": "tsx watch src/gateway/server.ts",
    "start": "tsx src/gateway/server.ts",
    "setup:browsers": "pnpm exec playwright install chromium --with-deps",
    "probe:model": "node --import tsx scripts/probe-local-model.ts",
    "codex:login": "tsx scripts/alfred-cli.ts auth login openai",
    "codex:status": "tsx scripts/alfred-cli.ts auth status openai",
    "codex:logout": "tsx scripts/alfred-cli.ts auth logout openai",
    "codex:app-server-gate": "tsx scripts/codex-app-server-gate.ts",
    "alfred": "tsx scripts/alfred-cli.ts",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:security",
    "test:unit": "node --import tsx --import ./tests/setup/env.mjs --test tests/unit/**/*.test.ts",
    "test:integration": "node --import tsx --import ./tests/setup/env.mjs --test tests/integration/**/*.test.ts",
    "test:smoke": "node --import tsx --import ./tests/setup/env.mjs --test tests/smoke/**/*.test.ts",
    "test:security": "node --import tsx --import ./tests/setup/env.mjs --test tests/security/**/*.test.ts",
    "pack:check": "npm run build && node scripts/check-package.mjs",
    "smoke:package": "npm run build && node scripts/smoke-package.mjs",
    "lint:layers": "eslint src"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "cheerio": "^1.1.2",
    "dotenv": "^16.6.1",
    "hono": "^4.9.8",
    "node-telegram-bot-api": "^0.67.0",
    "playwright": "^1.55.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/node-telegram-bot-api": "^0.64.14",
    "eslint": "^10.0.3",
    "eslint-plugin-boundaries": "^6.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.57.1"
  }
}
